generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}

model JobListing {
  id          String   @id @default(uuid())
  externalId  String
  source      String
  title       String
  company     String
  url         String
  description String
  location    String?
  status      String   @default("NEW")
  score       Int      @default(0)
  matchReasons String[]
  matchedSkills String[]
  missingSkills String[]
  retrievedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  applications JobApplication[]

  @@unique([externalId, source])
}

model CandidateProfile {
  id             String           @id @default(uuid())
  name           String
  email          String?
  targetRole     String?          @default("Software Engineer Intern")
  targetGradYear Int?             @default(2028)
  rawResume      String?
  skills         String[]
  experience     Json?
  education      Json?
  applications   JobApplication[]
  documents      Document[]
}

model JobApplication {
  id                 String           @id @default(uuid())
  jobListingId       String
  jobListing         JobListing       @relation(fields: [jobListingId], references: [id])
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  status             String           @default("DRAFT")
  stage              String           @default("BOOKMARKED") // "BOOKMARKED", "APPLYING", "APPLIED", "INTERVIEWING", "OFFERED", "REJECTED", "ARCHIVED"
  isApproved         Boolean          @default(false)
  notes              String?
  appliedUrl         String?
  submittedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  documents          Document[]
}

model Document {
  id                 String           @id @default(uuid())
  type               String           // "RESUME", "COVER_LETTER", "TAILORED_RESUME"
  version            Int              @default(1)
  content            String
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  jobApplicationId   String?
  jobApplication     JobApplication?  @relation(fields: [jobApplicationId], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entityId  String
  timestamp DateTime @default(now())
  metadata  Json?
}

model SyncRun {
  id            String    @id @default(uuid())
  source        String
  status        String    // "RUNNING", "SUCCESS", "FAILED", "PARTIAL"
  fetchedCount  Int       @default(0)
  newCount      Int       @default(0)
  updatedCount  Int       @default(0)
  errorMessage  String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  durationMs    Int?
}

model JobSourceConfig {
  id           String    @id @default(uuid())
  sourceType   String    // "greenhouse", "ashby", "lever", "arbeitnow"
  name         String    // e.g. "Cloudflare", "Linear", "Spotify", "Netflix"
  boardToken   String    // e.g. "cloudflare", "linear", "spotify", "netflix"
  enabled      Boolean   @default(true)
  lastSyncedAt DateTime?
  jobCount     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([sourceType, boardToken])
}


