# Environment
NODE_ENV=development

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_agent
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/job_agent?schema=public"

# API
PORT=3001
FRONTEND_URL=http://localhost:3000

# Gemini
GEMINI_KEY=

# Gmail (read-only sync). Create a "Web application" OAuth client in Google Cloud and add the
# redirect URI below as an authorized redirect URI. GOOGLE_CLIENT_ID/SECRET/REDIRECT_URI are
# accepted as legacy aliases.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/api/gmail/oauth2callback
# First sync looks back this many days; later syncs are incremental.
GMAIL_INITIAL_LOOKBACK_DAYS=60
# Most messages processed per sync run (the rest are picked up by the next run).
GMAIL_SYNC_MAX_MESSAGES=150
